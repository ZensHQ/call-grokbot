{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "call-grokbot": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "https://registry.npmjs.org/call-grokbot/-/call-grokbot-0.1.1.tgz"
      ],
      "env": {
        "CALL_GROKBOT_AUTH_MODE": "browser"
      }
    }
  }
}
